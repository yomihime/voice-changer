  "cards": [
    {
      "dot": "cyan",
      "title": "两条实时入口",
      "items": [
        "浏览器通过 AudioWorklet 分块，并经 Socket.IO 或 REST 传输 PCM",
        "ServerDevice 直接管理本机输入、输出和监听设备"
      ]
    },
    {
      "dot": "emerald",
      "title": "单一处理主链",
      "items": [
        "所有入口汇聚到 VoiceChangerManager.changeVoice",
        "VoiceChangerV2 只执行一次 SOLA、crossfade 与输出长度整形"
      ]
    },
    {
      "dot": "violet",
      "title": "后端解耦边界",
      "items": [
        "RVCr2 持有设置并在 legacy 与 official 之间显式切换",
        "Official RVC 仅负责推理，不拥有音频设备、LAN 传输或模型槽"
      ]
    }
